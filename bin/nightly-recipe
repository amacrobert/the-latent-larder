#!/usr/bin/env bash
#
# Draft a new recipe, shoot its photo, and push the result. Built for cron.
#
#   0 6 * * *  /srv/the-latent-larder/bin/nightly-recipe >> /var/log/larder.log 2>&1
#
# Cron gives a process almost no environment, so everything this needs is
# either read from LARDER_ENV_FILE or resolved by absolute path below. It runs
# under flock, so a slow run can never overlap the next one, and it commits
# with git directly rather than asking Claude to do it.
#
# Requires: claude, git, cwebp, dwebp, curl, jq — and OPENAI_API_KEY in the env file.

set -euo pipefail

env_file="${LARDER_ENV_FILE:-/etc/larder.env}"
branch="${LARDER_BRANCH:-main}"
claude_args="${LARDER_CLAUDE_ARGS:---permission-mode auto}"

# Deliberately not /var/lock. That directory is world-writable and sticky, and
# Ubuntu ships fs.protected_regular=2, which stops one user opening another
# user's file there for writing — root included. So a single stray `sudo` run
# would leave a root-owned lockfile that blocks every later run. A lock under
# $HOME is owned by whoever runs the script, which is the only sane owner.
lockfile="${LARDER_LOCK:-${HOME:-/tmp}/.cache/larder-nightly.lock}"

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

log()  { printf '%s  %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"; }
die()  { log "ERROR: $*"; exit 1; }

# This must run as the user who owns the Claude credentials in ~/.claude and the
# ssh key that can push. Under sudo, none of those are root's, so the run would
# get several steps in and then fail — better to say so immediately.
if [[ "$(id -u)" -eq 0 && "${LARDER_ALLOW_ROOT:-}" != "1" ]]; then
  die "don't run this with sudo. Run it as the user that owns ~/.claude and the
     push key. If the env file isn't readable, fix that instead:
       sudo chown root:\$USER $env_file && sudo chmod 640 $env_file"
fi

# Hold an exclusive lock for the life of the script by keeping fd 9 open on it.
# -n means a run still going from last night makes this one bow out rather than
# queue up behind it. The lock releases automatically when the process ends,
# including on a crash, so there is no stale lockfile to clean up.
if command -v flock >/dev/null; then
  mkdir -p "$(dirname "$lockfile")" || die "cannot create $(dirname "$lockfile")"
  exec 9>"$lockfile" || die "cannot open lock $lockfile"
  flock -n 9 || { log "another run holds $lockfile; exiting"; exit 0; }
else
  log "WARNING: flock not found; running without an overlap guard"
fi

log "=== nightly recipe run starting in $root ==="

# --- environment ------------------------------------------------------------

# PATH under cron is typically just /usr/bin:/bin. Claude usually lands in one
# of these; add to LARDER_EXTRA_PATH rather than editing this line.
export PATH="${LARDER_EXTRA_PATH:-$HOME/.local/bin:/usr/local/bin}:$PATH"

if [[ -r "$env_file" ]]; then
  # set -a exports everything the file defines, so OPENAI_API_KEY reaches the
  # generator without this script ever naming or echoing its value.
  set -a; . "$env_file"; set +a
  log "loaded $env_file"
elif [[ -e "$env_file" ]]; then
  # Present but unreadable. Grant read access rather than escalating the whole
  # run to root — see the id check above for why sudo is a dead end here.
  die "$env_file exists but $(id -un) cannot read it. Grant access with:
       sudo chown root:$(id -gn) $env_file && sudo chmod 640 $env_file"
else
  die "$env_file does not exist. Create it with the key in it, or point
     LARDER_ENV_FILE at another file."
fi

[[ -n "${OPENAI_API_KEY:-}" ]] || die "OPENAI_API_KEY not set by $env_file"

for cmd in claude git cwebp dwebp curl jq; do
  command -v "$cmd" >/dev/null || die "$cmd not found on PATH ($PATH)"
done

cd "$root"

# --- start from a clean, current tree ---------------------------------------

if [[ -n "$(git status --porcelain)" ]]; then
  die "working tree is dirty; refusing to run. Resolve it and re-run."
fi

log "fetching origin/$branch"
git fetch --quiet origin "$branch"
git checkout --quiet "$branch"
git merge --quiet --ff-only "origin/$branch" \
  || die "local $branch has diverged from origin; resolve by hand"

# --- do the work ------------------------------------------------------------

log "drafting a recipe (/new-recipe)"
claude $claude_args -p "/new-recipe" || die "/new-recipe failed"

log "shooting the photo (/recipe-image-generator)"
claude $claude_args -p "/recipe-image-generator" || die "/recipe-image-generator failed"

# --- commit and push, with git rather than a prompt -------------------------

if [[ -z "$(git status --porcelain)" ]]; then
  log "nothing changed; nothing to commit"
  exit 0
fi

git add -A

# Name the commit after the recipe that appeared, matching the repo's history
# ("Add slow lamb shoulder with anchovy" — lowercase after the verb).
added="$(git diff --cached --name-only --diff-filter=A -- _recipes)"
added_count="$(printf '%s' "$added" | grep -c . || true)"

case "$added_count" in
  0) message="Add recipe photos" ;;
  1) title="$(awk '/^title: /{sub(/^title: /, ""); print; exit}' "$added" \
              | tr '[:upper:]' '[:lower:]')"
     message="Add ${title:-a recipe}" ;;
  *) message="Add new recipes and photos" ;;
esac

# The bot's identity, needed by commit and again by the rebase below. Without
# it a rebase on a machine with no global git config stops to ask who you are.
git_bot=(git -c "user.name=${GIT_AUTHOR_NAME:-Latent Larder bot}"
             -c "user.email=${GIT_AUTHOR_EMAIL:-larder@localhost}")

log "committing: $message"
"${git_bot[@]}" commit --quiet -m "$message"

# The tree was current when this run started, but drafting the recipe and
# shooting its photo take minutes, and $branch can move in that window — the
# deploy workflow never commits, but a person or a second machine can. A push
# that lost that race is a non-fast-forward, not a broken deploy key, and the
# fix is to replay tonight's commit on top of whatever landed rather than to
# fail the run and skip a night.
#
# Rebase rather than merge: this commit only adds files under _recipes/ and
# assets/images/, so it replays cleanly onto anything that is not another
# recipe of the same name, and the history stays a straight line.
attempts="${LARDER_PUSH_ATTEMPTS:-3}"

for attempt in $(seq 1 "$attempts"); do
  log "pushing to origin/$branch (attempt $attempt/$attempts)"
  git push --quiet origin "$branch" && break

  [[ "$attempt" -lt "$attempts" ]] \
    || die "push still rejected after $attempts attempts; check the deploy key
     and whether $branch is protected"

  log "push rejected; pulling origin/$branch and replaying on top"
  git fetch --quiet origin "$branch" || die "fetch failed while retrying the push"

  "${git_bot[@]}" rebase --quiet "origin/$branch" || {
    "${git_bot[@]}" rebase --abort >/dev/null 2>&1 || true
    die "cannot replay $message onto origin/$branch; resolve by hand"
  }
done

log "pushed $(git rev-parse --short HEAD) — $message"

# --- report -----------------------------------------------------------------

if ! ./bin/recipes-without-images >/dev/null 2>&1; then
  log "WARNING: some recipes still have no photo:"
  ./bin/recipes-without-images || true
fi

log "=== done ==="
